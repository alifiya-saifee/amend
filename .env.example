# Copy to .env and fill in. Never commit .env.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
DATABASE_URL=sqlite:///./amend.db
BASE_URL=http://localhost:8000
# platform = Option 2 (demo: brand pays Amend's sandbox business account; creator paid by Payouts)
MONEY_RAIL=platform
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=
AMEND_DEMO_PASSWORD=
# Long random strings (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))")
AMEND_SESSION_SECRET=
AMEND_TICK_SECRET=
# Sandbox personal accounts (fake PayPal sandbox emails)
SANDBOX_BRAND_EMAIL=
SANDBOX_CREATOR_EMAIL=
SANDBOX_EDITOR_EMAIL=
