# Copy to .env and fill in. Never commit .env.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
DATABASE_URL=sqlite:///./amend.db
# On Render: Supabase Postgres (session pooler), set in the Render dashboard. Format:
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
BASE_URL=http://localhost:8000
# platform = Option 2 (demo: brand pays Amend's sandbox business account; creator paid by Payouts)
MONEY_RAIL=platform
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_MODEL=
AMEND_DEMO_PASSWORD=
# judges-only logins (judge.sara@creators.example, judge.brand@amend.example); never the demo password
JUDGE_PASSWORD=
# capture into PayPal's headroom (115% or +$75): off until a sandbox probe confirms the account allows it
PAYPAL_OVERCAPTURE=false
# Long random strings (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))")
AMEND_SESSION_SECRET=
AMEND_TICK_SECRET=
# Sandbox personal accounts (fake PayPal sandbox emails)
SANDBOX_BRAND_EMAIL=
SANDBOX_CREATOR_EMAIL=
SANDBOX_EDITOR_EMAIL=
# Local browser tests only: the sandbox buyer's PayPal sandbox password (never your real PayPal)
SANDBOX_BRAND_PASSWORD=
# Instagram lookup on Discover (Meta Business Discovery; Facebook Login token with instagram_basic +
# pages_read_engagement, from an Instagram professional account linked to a Facebook Page). Off unless enabled.
IG_LOOKUP_ENABLED=false
META_IG_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0
